# Flask secret key (obligatoire en production)
SECRET_KEY=change_me_to_a_long_random_value

# Optionnel: chemin DB explicite (utile sur PythonAnywhere)
# DATABASE_PATH=/home/<username>/gestion-multi-profs/ecole_multi.db

# Secret de signature des licences (obligatoire; generer une valeur aleatoire d'au moins 32 caracteres)
SECRET_LICENCE=
# Optional stable ID for shared hosts that report a different MAC address to
# web workers and consoles. Generate one value per deployed server.
LICENSE_MACHINE_ID=

# Creation initiale de l'administrateur (a retirer ensuite de l'environnement)
# ADMIN_USER=admin
# ADMIN_PASS=change_me
# ADMIN_DISPLAY=Administrateur

# Desactive par defaut: les comptes sont crees par un administrateur.
# ALLOW_SELF_REGISTRATION=0

# Active HSTS uniquement sur un domaine HTTPS en production.
# ENABLE_HSTS=1

# En production: laisser actif (1). Mettre 0 seulement si migration machine.
# STRICT_LICENSE_MACHINE_CHECK=1

# OCR PDF scanne via OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_OCR_MODEL=gpt-4.1

# OCR PDF scanne via Google Gemini (Alternative gratuite)
# GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.5-flash

# Local debug
# FLASK_DEBUG=1

# Taille maximale des fichiers uploadés (en octets) : 50 Mo (50 * 1024 * 1024)
# MAX_CONTENT_LENGTH=52428800
